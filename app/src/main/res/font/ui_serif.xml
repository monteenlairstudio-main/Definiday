<?xml version="1.0" encoding="utf-8"?>
<!-- The one interface serif (AppTheme fontFamily): Definiday Serif (Libre Baskerville with U+202F, tools/fonts_nnbsp.py), a variable file (wght 400-700) named twice so that
     textStyle bold takes the real 700 instead of a synthetic one. No italic cut: avoid textStyle italic (it would be slanted). -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font android:font="@font/definiday_serif" android:fontStyle="normal" android:fontWeight="400" android:fontVariationSettings="'wght' 400" />
    <font android:font="@font/definiday_serif" android:fontStyle="normal" android:fontWeight="700" android:fontVariationSettings="'wght' 700" />
</font-family>
