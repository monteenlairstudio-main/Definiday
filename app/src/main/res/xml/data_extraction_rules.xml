<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ cloud backup and device-to-device transfer -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="wallpaper_state.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="wallpaper_state.xml" />
    </device-transfer>
</data-extraction-rules>
