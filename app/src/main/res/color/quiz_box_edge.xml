<?xml version="1.0" encoding="utf-8"?>
<!-- The quiz check-box: plume while the option can be chosen, ink2 once disabled (no plume box on an option that looks dead). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="@color/ink2" />
    <item android:color="@color/accent" />
</selector>
