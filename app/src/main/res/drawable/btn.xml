<?xml version="1.0" encoding="utf-8"?>
<!-- Btn: pressed = ripple, focused (keyboard, Switch Access) = 3 dp outline (accent on surface 4.22:1 light, 7.15:1 dark), disabled = flat without outline.
     The quiz tints it (background.mutate().setTint) for right/wrong. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/ripple">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape><corners android:radius="12dp" /><solid android:color="@color/surface_off" /></shape>
            </item>
            <item android:state_focused="true">
                <shape><corners android:radius="12dp" /><solid android:color="@color/surface" /><stroke android:width="3dp" android:color="@color/accent" /></shape>
            </item>
            <item>
                <shape><corners android:radius="12dp" /><solid android:color="@color/surface" /><stroke android:width="1dp" android:color="@color/accent" /></shape>
            </item>
        </selector>
    </item>
</ripple>
