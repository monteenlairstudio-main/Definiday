<?xml version="1.0" encoding="utf-8"?>
<!-- Btn: pressed = ripple, disabled = flat without outline. The quiz tints it (background.mutate().setTint) for right/wrong. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33886A34">
    <item>
        <selector>
            <item android:state_enabled="false">
                <shape><corners android:radius="12dp" /><solid android:color="@color/surface_off" /></shape>
            </item>
            <item>
                <shape><corners android:radius="12dp" /><solid android:color="@color/surface" /><stroke android:width="1dp" android:color="@color/accent" /></shape>
            </item>
        </selector>
    </item>
</ripple>
