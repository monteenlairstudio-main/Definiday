<?xml version="1.0" encoding="utf-8"?>
<!-- Primary: plume fill over a 3 dp accent_dark edge, like an ink pad (text bg on it 7.4:1 light, 8.95:1 dark);
     focused = inner bg ring (same ratios against the fill). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="?android:attr/colorControlHighlight">
    <item>
        <selector>
            <item android:state_focused="true">
                <layer-list>
                    <item><shape><corners android:radius="@dimen/radius_paper" /><solid android:color="@color/accent_dark" /></shape></item>
                    <item android:bottom="3dp"><shape><corners android:radius="@dimen/radius_paper" /><solid android:color="@color/accent" /></shape></item>
                    <item android:bottom="7dp" android:left="4dp" android:right="4dp" android:top="4dp">
                        <shape><corners android:radius="@dimen/radius_small" /><stroke android:width="2dp" android:color="@color/bg" /></shape>
                    </item>
                </layer-list>
            </item>
            <item>
                <layer-list>
                    <item><shape><corners android:radius="@dimen/radius_paper" /><solid android:color="@color/accent_dark" /></shape></item>
                    <item android:bottom="3dp"><shape><corners android:radius="@dimen/radius_paper" /><solid android:color="@color/accent" /></shape></item>
                </layer-list>
            </item>
        </selector>
    </item>
</ripple>
