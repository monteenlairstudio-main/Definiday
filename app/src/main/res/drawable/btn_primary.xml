<?xml version="1.0" encoding="utf-8"?>
<!-- Primary: accent fill (text bg on it 4.72:1 light, 8.19:1 dark); focused = inner bg ring (same ratios against the fill). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="?android:attr/colorControlHighlight">
    <item>
        <selector>
            <item android:state_focused="true">
                <layer-list>
                    <item><shape><corners android:radius="16dp" /><solid android:color="@color/accent" /></shape></item>
                    <item android:bottom="4dp" android:left="4dp" android:right="4dp" android:top="4dp">
                        <shape><corners android:radius="12dp" /><stroke android:width="2dp" android:color="@color/bg" /></shape>
                    </item>
                </layer-list>
            </item>
            <item>
                <shape><corners android:radius="16dp" /><solid android:color="@color/accent" /></shape>
            </item>
        </selector>
    </item>
</ripple>
