<?xml version="1.0" encoding="utf-8"?>
<!-- Envelope (style Envelope: « Autres lettres du jour », and any pick among letters): kraft, flap, kraft_dark rule.
     Selected (the letter on the card) = the app's selection, 2 dp accent outline, plus a wax dot on the flap (the state is in the outline,
     the dot only repeats it; TalkBack says « sélectionné »). Focused = 3 dp accent outline. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/ripple">
    <item>
        <selector>
            <item android:state_focused="true">
                <layer-list>
                    <item><shape><corners android:radius="@dimen/radius_small" /><solid android:color="@color/surface" /><stroke android:width="3dp" android:color="@color/accent" /></shape></item>
                    <item android:drawable="@drawable/envelope_flap" android:gravity="top|fill_horizontal" android:height="20dp" android:left="3dp" android:right="3dp" android:top="3dp" />
                </layer-list>
            </item>
            <item android:state_selected="true">
                <layer-list>
                    <item><shape><corners android:radius="@dimen/radius_small" /><solid android:color="@color/surface" /><stroke android:width="2dp" android:color="@color/accent" /></shape></item>
                    <item android:drawable="@drawable/envelope_flap" android:gravity="top|fill_horizontal" android:height="20dp" android:left="2dp" android:right="2dp" android:top="2dp" />
                    <item android:gravity="top|center_horizontal" android:width="10dp" android:height="10dp" android:top="17dp">
                        <shape android:shape="oval"><solid android:color="@color/wax" /></shape>
                    </item>
                </layer-list>
            </item>
            <item>
                <layer-list>
                    <item><shape><corners android:radius="@dimen/radius_small" /><solid android:color="@color/surface" /><stroke android:width="1dp" android:color="@color/kraft_dark" /></shape></item>
                    <item android:drawable="@drawable/envelope_flap" android:gravity="top|fill_horizontal" android:height="20dp" android:left="1dp" android:right="1dp" android:top="1dp" />
                </layer-list>
            </item>
        </selector>
    </item>
</ripple>
