<?xml version="1.0" encoding="utf-8"?>
<!-- Btn as a pill (home chips of the day): same states as btn.xml, the radius is clamped to half the height. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/ripple">
    <item>
        <selector>
            <item android:state_focused="true">
                <shape><corners android:radius="100dp" /><solid android:color="@color/surface" /><stroke android:width="3dp" android:color="@color/accent" /></shape>
            </item>
            <item>
                <shape><corners android:radius="100dp" /><solid android:color="@color/surface" /><stroke android:width="1dp" android:color="@color/accent" /></shape>
            </item>
        </selector>
    </item>
</ripple>
