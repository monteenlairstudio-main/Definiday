<?xml version="1.0" encoding="utf-8"?>
<!-- Glose's note (home banner; for every warning box): warm note paper with its card_edge rule, a wax-red margin rule at the start;
     clickable: ripple, 3 dp accent outline when focused (accent on warn 6.55:1 light, 6.8:1 dark). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/ripple">
    <item>
        <selector>
            <item android:state_focused="true">
                <shape><corners android:radius="@dimen/radius_paper" /><solid android:color="@color/warn" /><stroke android:width="3dp" android:color="@color/accent" /></shape>
            </item>
            <item>
                <layer-list>
                    <item><shape><corners android:radius="@dimen/radius_paper" /><solid android:color="@color/warn" /><stroke android:width="1dp" android:color="@color/card_edge" /></shape></item>
                    <item android:gravity="start|fill_vertical" android:width="2dp" android:start="12dp" android:top="1dp" android:bottom="1dp">
                        <shape><solid android:color="@color/wax" /></shape>
                    </item>
                </layer-list>
            </item>
        </selector>
    </item>
</ripple>
