<?xml version="1.0" encoding="utf-8"?>
<!-- A sheet of paper (anecdote, rate prompt, any soft card): sheet fill and its 1 dp card_edge rule (the fill alone is 1.08:1 on bg).
     The notebook (Seyès) is this sheet plus Postal.Seyes over it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <corners android:radius="@dimen/radius_paper" />
    <solid android:color="@color/sheet" />
    <stroke android:width="1dp" android:color="@color/card_edge" />
</shape>
