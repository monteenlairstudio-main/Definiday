<?xml version="1.0" encoding="utf-8"?>
<!-- Réglages: calm sheets (card_soft, style Sheet) under serif Label rubrics; actions apart from settings (« Ailleurs sur votre téléphone ») -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="24dp">

        <TextView
            style="@style/Title"
            android:text="@string/settings" />

        <!-- Mot du jour -->
        <TextView
            style="@style/Rubric"
            android:text="@string/group_word" />

        <LinearLayout style="@style/Sheet">

            <Switch
                android:id="@+id/enabled"
                style="@style/Toggle"
                android:text="@string/enabled" />

            <Button
                android:id="@+id/time"
                style="@style/Setting" />

            <!-- exact alarms refused (default on Android 14+): Glose's note, as the home banner -->
            <LinearLayout
                android:id="@+id/exact_box"
                style="@style/NoteBox">

                <TextView
                    style="@style/Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/exact_no"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/exact_ask"
                    style="@style/Row"
                    android:text="@string/exact_ask" />
            </LinearLayout>

            <TextView
                style="@style/Field"
                android:labelFor="@+id/per_day"
                android:text="@string/per_day" />

            <Spinner
                android:id="@+id/per_day"
                style="@style/Choice" />

            <Switch
                android:id="@+id/more_quotes"
                style="@style/Toggle"
                android:text="@string/more_quotes" />

            <TextView
                style="@style/Help"
                android:text="@string/more_quotes_hint" />

            <Switch
                android:id="@+id/guess"
                style="@style/Toggle"
                android:text="@string/guess" />

            <TextView
                style="@style/Help"
                android:text="@string/guess_hint" />
        </LinearLayout>

        <!-- actions, not settings (audit 011 n° 5): the free widget first, it has no other entry point -->
        <TextView
            style="@style/Rubric"
            android:text="@string/group_elsewhere" />

        <LinearLayout style="@style/Sheet">

            <!-- the launcher's pin dialog (Widget.pin) -->
            <Button
                android:id="@+id/widget_add"
                style="@style/Row"
                android:text="@string/widget_add" />

            <TextView
                style="@style/Help"
                android:text="@string/widget_add_hint" />

            <Button
                android:id="@+id/test"
                style="@style/Row"
                android:layout_marginTop="16dp"
                android:text="@string/test" />
        </LinearLayout>

        <!-- Écran de verrouillage -->
        <TextView
            style="@style/Rubric"
            android:text="@string/group_lock" />

        <LinearLayout style="@style/Sheet">

            <TextView
                style="@style/Field"
                android:labelFor="@+id/mode"
                android:text="@string/mode" />

            <Spinner
                android:id="@+id/mode"
                style="@style/Choice" />

            <TextView
                android:id="@+id/wallpaper_hint"
                style="@style/Help"
                android:text="@string/wallpaper_hint" />

            <!-- the lock screen has its own wallpaper (Wall.ownNote): Glose's note, instead of wallpaper_hint -->
            <TextView
                android:id="@+id/lock_own"
                style="@style/NoteBox"
                android:textAppearance="@style/Body"
                android:textSize="15sp" />

            <TextView
                style="@style/Field"
                android:labelFor="@+id/duration"
                android:text="@string/duration" />

            <Spinner
                android:id="@+id/duration"
                style="@style/Choice" />

            <TextView
                android:id="@+id/duration_hint"
                style="@style/Help" />

            <TextView
                android:id="@+id/unlocks_label"
                style="@style/Field"
                android:labelFor="@+id/unlocks"
                android:text="@string/unlocks" />

            <Spinner
                android:id="@+id/unlocks"
                style="@style/Choice" />

            <TextView
                android:id="@+id/unlocks_hint"
                style="@style/Help"
                android:text="@string/unlocks_hint" />

            <TextView
                android:id="@+id/text_pos_label"
                style="@style/Field"
                android:labelFor="@+id/text_pos"
                android:text="@string/text_pos" />

            <Spinner
                android:id="@+id/text_pos"
                style="@style/Choice" />
        </LinearLayout>

        <!-- Quiz du soir -->
        <TextView
            style="@style/Rubric"
            android:text="@string/group_quiz" />

        <LinearLayout style="@style/Sheet">

            <Switch
                android:id="@+id/quiz_enabled"
                style="@style/Toggle"
                android:text="@string/quiz_enabled" />

            <Button
                android:id="@+id/quiz_time"
                style="@style/Setting" />

            <TextView
                android:id="@+id/quiz_early"
                style="@style/Help"
                android:visibility="gone"
                android:text="@string/quiz_early" />
        </LinearLayout>

        <!-- Apparence -->
        <TextView
            style="@style/Rubric"
            android:text="@string/group_look" />

        <LinearLayout style="@style/Sheet">

            <!-- Glose's name: checked as typed (Prefs.nameError), saved on Done, focus loss or leaving; maxLength caps a paste,
                 the 24 code points are checked in code. No autofill: textPersonName would offer the user's own name. Not saved
                 in the instance state: after a profile import (recreate) the field shows the imported name, not the typed one. -->
            <TextView
                style="@style/Field"
                android:labelFor="@+id/glose_name"
                android:text="@string/name_label" />

            <EditText
                android:id="@+id/glose_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/field"
                android:importantForAutofill="no"
                android:imeOptions="actionDone"
                android:inputType="textPersonName|textCapWords"
                android:maxLength="64"
                android:minHeight="48dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:saveEnabled="false"
                android:textColor="@color/ink"
                android:textSize="16sp" />

            <TextView
                style="@style/Help"
                android:text="@string/name_hint" />

            <Button
                android:id="@+id/name_reset"
                style="@style/Link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <!-- opens StylesActivity: a navigation row (chevron), its counts on a second line (SettingsActivity.onResume) -->
            <Button
                android:id="@+id/styles_open"
                style="@style/Nav"
                android:text="@string/styles_row" />

            <Switch
                android:id="@+id/sounds"
                style="@style/Toggle"
                android:text="@string/sounds" />

            <TextView
                style="@style/Help"
                android:text="@string/sounds_hint" />
        </LinearLayout>

        <!-- Mon profil: the profile as a file, through the system file picker (Profile) -->
        <TextView
            style="@style/Rubric"
            android:text="@string/group_profile" />

        <LinearLayout style="@style/Sheet">

            <Button
                android:id="@+id/profile_export"
                style="@style/Row"
                android:text="@string/profile_export" />

            <TextView
                style="@style/Help"
                android:text="@string/profile_hint" />

            <Button
                android:id="@+id/profile_import"
                style="@style/Row"
                android:layout_marginTop="16dp"
                android:text="@string/profile_import" />
        </LinearLayout>

        <!-- Mises à jour (Update.kt): hidden when BuildConfig.SELF_UPDATE is false -->
        <TextView
            android:id="@+id/update_rubric"
            style="@style/Rubric"
            android:text="@string/group_update" />

        <LinearLayout
            android:id="@+id/update_sheet"
            style="@style/Sheet">

            <TextView
                android:id="@+id/update_version"
                style="@style/Field" />

            <Button
                android:id="@+id/update_check"
                style="@style/Row"
                android:text="@string/update_check" />

            <!-- the check's answer, the new version's notes, the download progress -->
            <TextView
                android:id="@+id/update_status"
                style="@style/Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:accessibilityLiveRegion="polite"
                android:visibility="gone" />

            <Button
                android:id="@+id/update_install"
                style="@style/Row"
                android:text="@string/update_install"
                android:visibility="gone" />

            <!-- optional safety step before installing: the same export as « Mon profil » -->
            <Button
                android:id="@+id/update_backup"
                style="@style/Link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/update_backup"
                android:visibility="gone" />

            <TextView
                style="@style/Help"
                android:text="@string/update_kept" />

            <Switch
                android:id="@+id/update_auto"
                style="@style/Toggle"
                android:text="@string/update_auto" />

            <TextView
                style="@style/Help"
                android:text="@string/update_auto_hint" />

            <Button
                android:id="@+id/update_releases"
                style="@style/Link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/update_releases" />
        </LinearLayout>

        <TextView
            style="@style/Rubric"
            android:text="@string/credits_title" />

        <TextView
            style="@style/Help"
            android:text="@string/credits" />
    </LinearLayout>
</ScrollView>
