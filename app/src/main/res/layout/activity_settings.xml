<?xml version="1.0" encoding="utf-8"?>
<!-- Réglages: calm sheets (card_soft, style Sheet) under serif Label rubrics; actions apart from settings (« Ailleurs sur votre téléphone ») -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="24dp">

        <TextView
            style="@style/Title"
            android:text="@string/settings" />

        <!-- Mot du jour -->
        <TextView
            style="@style/Rubric"
            android:text="@string/group_word" />

        <LinearLayout style="@style/Sheet">

            <Switch
                android:id="@+id/enabled"
                style="@style/Toggle"
                android:text="@string/enabled" />

            <Button
                android:id="@+id/time"
                style="@style/Setting" />

            <!-- exact alarms refused (default on Android 14+): Glose's note, as the home banner -->
            <LinearLayout
                android:id="@+id/exact_box"
                style="@style/NoteBox">

                <TextView
                    style="@style/Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/exact_no"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/exact_ask"
                    style="@style/Row"
                    android:text="@string/exact_ask" />
            </LinearLayout>

            <TextView
                style="@style/Field"
                android:labelFor="@+id/per_day"
                android:text="@string/per_day" />

            <Spinner
                android:id="@+id/per_day"
                style="@style/Choice" />

            <Switch
                android:id="@+id/more_quotes"
                style="@style/Toggle"
                android:text="@string/more_quotes" />

            <TextView
                style="@style/Help"
                android:text="@string/more_quotes_hint" />

            <Switch
                android:id="@+id/guess"
                style="@style/Toggle"
                android:text="@string/guess" />

            <TextView
                style="@style/Help"
                android:text="@string/guess_hint" />
        </LinearLayout>

        <!-- actions, not settings (audit 011 n° 5): the free widget first, it has no other entry point -->
        <TextView
            style="@style/Rubric"
            android:text="@string/group_elsewhere" />

        <LinearLayout style="@style/Sheet">

            <!-- the launcher's pin dialog (Widget.pin) -->
            <Button
                android:id="@+id/widget_add"
                style="@style/Row"
                android:text="@string/widget_add" />

            <TextView
                style="@style/Help"
                android:text="@string/widget_add_hint" />

            <Button
                android:id="@+id/test"
                style="@style/Row"
                android:layout_marginTop="16dp"
                android:text="@string/test" />
        </LinearLayout>

        <!-- Écran de verrouillage -->
        <TextView
            style="@style/Rubric"
            android:text="@string/group_lock" />

        <LinearLayout style="@style/Sheet">

            <TextView
                style="@style/Field"
                android:labelFor="@+id/mode"
                android:text="@string/mode" />

            <Spinner
                android:id="@+id/mode"
                style="@style/Choice" />

            <TextView
                android:id="@+id/wallpaper_hint"
                style="@style/Help"
                android:text="@string/wallpaper_hint" />

            <!-- the lock screen has its own wallpaper (Wall.ownNote): Glose's note, instead of wallpaper_hint -->
            <TextView
                android:id="@+id/lock_own"
                style="@style/NoteBox"
                android:textAppearance="@style/Body"
                android:textSize="15sp" />

            <TextView
                style="@style/Field"
                android:labelFor="@+id/duration"
                android:text="@string/duration" />

            <Spinner
                android:id="@+id/duration"
                style="@style/Choice" />

            <TextView
                android:id="@+id/duration_hint"
                style="@style/Help" />

            <TextView
                android:id="@+id/unlocks_label"
                style="@style/Field"
                android:labelFor="@+id/unlocks"
                android:text="@string/unlocks" />

            <Spinner
                android:id="@+id/unlocks"
                style="@style/Choice" />

            <TextView
                android:id="@+id/unlocks_hint"
                style="@style/Help"
                android:text="@string/unlocks_hint" />

            <TextView
                android:id="@+id/text_pos_label"
                style="@style/Field"
                android:labelFor="@+id/text_pos"
                android:text="@string/text_pos" />

            <Spinner
                android:id="@+id/text_pos"
                style="@style/Choice" />
        </LinearLayout>

        <!-- Quiz du soir -->
        <TextView
            style="@style/Rubric"
            android:text="@string/group_quiz" />

        <LinearLayout style="@style/Sheet">

            <Switch
                android:id="@+id/quiz_enabled"
                style="@style/Toggle"
                android:text="@string/quiz_enabled" />

            <Button
                android:id="@+id/quiz_time"
                style="@style/Setting" />
        </LinearLayout>

        <!-- Apparence -->
        <TextView
            style="@style/Rubric"
            android:text="@string/group_look" />

        <LinearLayout style="@style/Sheet">

            <!-- opens StylesActivity: a navigation row (chevron), its counts on a second line (SettingsActivity.onResume) -->
            <Button
                android:id="@+id/styles_open"
                style="@style/Nav"
                android:text="@string/styles_row" />

            <Switch
                android:id="@+id/sounds"
                style="@style/Toggle"
                android:text="@string/sounds" />

            <TextView
                style="@style/Help"
                android:text="@string/sounds_hint" />
        </LinearLayout>

        <TextView
            style="@style/Rubric"
            android:text="@string/credits_title" />

        <TextView
            style="@style/Help"
            android:text="@string/credits" />
    </LinearLayout>
</ScrollView>
