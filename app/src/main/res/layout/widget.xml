<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget (Widget.views), a postcard: paper edge, the palette's gradient, a stamp with today's postmark.
     The XML values are the picker preview (previewLayout): sérendipité, palette Aube. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_frame"
    android:padding="4dp">

    <ImageView
        android:id="@+id/widget_top"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg"
        android:tint="#FCE9DC" />

    <ImageView
        android:id="@+id/widget_bottom"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_fade"
        android:tint="#F3CFC4" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_mot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:maxLines="1"
                    android:text="@string/widget_sample_mot"
                    android:textColor="#7D2E4A"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_nature"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:maxLines="1"
                    android:text="@string/widget_sample_nature"
                    android:textColor="#904352"
                    android:textSize="13sp"
            </LinearLayout>

            <ImageView
                android:id="@+id/widget_stamp"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_stamp_preview" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_texte"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="16sp"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeTextType="uniform"
            android:ellipsize="end"
            android:fontFamily="serif"
            android:maxLines="4"
            android:text="@string/widget_sample_texte"
            android:textColor="#3A2730" />

        <TextView
            android:id="@+id/widget_auteur"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:maxLines="2"
            android:textColor="#904352"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
