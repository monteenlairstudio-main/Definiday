<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="24dp">

        <!-- shown when the chosen mode needs notifications and they are off -->
        <TextView
            android:id="@+id/notif_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@color/warn"
            android:minHeight="48dp"
            android:padding="12dp"
            android:text="@string/notif_off"
            android:textColor="@color/ink"
            android:textSize="15sp"
            android:visibility="gone" />

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal">

            <ImageView
                android:id="@+id/glose"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:contentDescription="@string/glose" />

            <!-- seasonal prop by date (MainActivity.season): still, small, decorative -->
            <ImageView
                android:id="@+id/season"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="bottom|end"
                android:layout_marginBottom="12dp"
                android:importantForAccessibility="no"
                android:visibility="gone" />
        </FrameLayout>

        <!-- one TalkBack stop reading label, word, nature, definition and example (API 28+) -->
        <LinearLayout
            android:id="@+id/card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:screenReaderFocusable="true">

            <TextView
                android:id="@+id/label"
                style="@style/Label"
                android:text="@string/today" />

            <!-- size fitted in code so the longest piece of the word holds on one line -->
            <TextView
                android:id="@+id/mot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:breakStrategy="simple"
                android:fontFamily="serif"
                android:hyphenationFrequency="none"
                android:textSize="40sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/nature"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="serif"
                android:textSize="16sp"
                android:textStyle="italic" />

            <TextView
                android:id="@+id/definition"
                android:hyphenationFrequency="normal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="serif"
                android:lineSpacingMultiplier="1.2"
                android:textSize="19sp" />

            <TextView
                android:id="@+id/exemple"
                android:hyphenationFrequency="normal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="serif"
                android:textSize="16sp"
                android:textStyle="italic" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">

            <Button
                android:id="@+id/academie"
                style="@style/Link"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/academie" />

            <Button
                android:id="@+id/cnrtl"
                style="@style/Link"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/cnrtl" />

            <!-- favourite star (words only), see Memory.favourites -->
            <CheckBox
                android:id="@+id/favori"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@null"
                android:button="@drawable/favori"
                android:contentDescription="@string/favori" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/anecdote_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/Label"
                android:text="@string/anecdote" />

            <TextView
                android:id="@+id/anecdote"
                style="@style/Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/source"
                style="@style/Link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/source" />
        </LinearLayout>

        <Button
            android:id="@+id/new_word"
            style="@style/Row"
            android:layout_marginTop="24dp"
            android:text="@string/new_word" />

        <TextView
            style="@style/Help"
            android:text="@string/new_word_hint" />

        <Button
            android:id="@+id/quiz_open"
            style="@style/Primary"
            android:layout_marginTop="12dp"
            android:text="@string/quiz_open" />

        <Button
            android:id="@+id/collection_open"
            style="@style/Row"
            android:text="@string/collection_open" />

        <Button
            android:id="@+id/mots_open"
            style="@style/Row"
            android:text="@string/mots_open" />

        <TextView
            style="@style/Label"
            android:layout_marginTop="24dp"
            android:text="@string/seen_today" />

        <!-- rows of chips, filled in code (wraps at large font sizes instead of scrolling sideways) -->
        <LinearLayout
            android:id="@+id/seen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/settings_open"
            style="@style/Link"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/settings_link" />
    </LinearLayout>
</ScrollView>
