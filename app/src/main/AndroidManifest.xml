<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- in-app update from the GitHub releases (Update.kt); to drop from a Google Play build (docs/mise_a_jour.md) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- exact daily alarm: on time, and allowed to start the unlock watch from the background (Alarms.requestIntent on 14+) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Wall.lockLive: getWallpaperInfo(FLAG_LOCK) is null for a live wallpaper whose package this app can't see -->
    <queries>
        <intent>
            <action android:name="android.service.wallpaper.WallpaperService" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".OnboardingActivity" android:exported="false" />
        <!-- labels: screen titles for TalkBack and Recents (audit 011 A6) -->
        <activity android:name=".QuizActivity" android:exported="false" android:label="@string/quiz_title" />
        <activity android:name=".CollectionActivity" android:exported="false" android:label="@string/collection_title" />
        <activity android:name=".SettingsActivity" android:exported="false" android:label="@string/settings" />
        <activity android:name=".StylesActivity" android:exported="false" android:label="@string/styles_title" />
        <activity android:name=".MotsActivity" android:exported="false" android:label="@string/mots_title" />
        <activity android:name=".DetailActivity" android:exported="false" android:label="@string/mots_title" />

        <!-- the shared card picture, read through the share intent's grant only -->
        <provider
            android:name=".ShareProvider"
            android:authorities="fr.definiday.share"
            android:exported="false"
            android:grantUriPermissions="true" />

        <receiver
            android:name=".DailyReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
        <!-- PackageInstaller's status for Update.install, through an explicit PendingIntent -->
        <receiver android:name=".UpdateReceiver" android:exported="false" />
        <receiver
            android:name=".Widget"
            android:exported="false"
            android:label="@string/today">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>
        <service
            android:name=".UnlockService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Retire le mot du fond d’écran de verrouillage au Nᵉ déverrouillage choisi par l’utilisateur" />
        </service>
    </application>
</manifest>
